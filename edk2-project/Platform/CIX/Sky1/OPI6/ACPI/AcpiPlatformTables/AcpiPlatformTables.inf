## @file
#  Board SSDT for the OPI6.
#
#  Orange Pi has not published the source of its board SSDT.  The table was
#  extracted from the vendor firmware image (vendor/orangepi/), and is staged
#  here as Ssdt.aml by scripts/fetch-blobs.py after a SHA-256 check.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = PlatformAcpiTables
  FILE_GUID                      = c1bb2ead-c76a-45dd-90b5-d40255170a9c
  MODULE_TYPE                    = USER_DEFINED
  VERSION_STRING                 = 1.0

[Binaries]
  ASL|Ssdt.aml|*
