+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <common/bl_common.h>
+#include <common/desc_image_load.h>
+#include <plat/common/platform.h>
+
+/*
+ * BL2 hands the images described in cix_bl2_mem_params_desc.c to the next
+ * stage unchanged: OP-TEE's entry state is set up by the OP-TEE dispatcher in
+ * BL31 and BL33's comes from the descriptor, so the pre/post image load hooks
+ * keep their (empty) weak defaults.
+ */
+
+void plat_flush_next_bl_params(void)
+{
+	flush_bl_params_desc();
+}
+
+struct bl_load_info *plat_get_bl_image_load_info(void)
+{
+	return get_bl_load_info_from_mem_params_desc();
+}
+
+struct bl_params *plat_get_next_bl_params(void)
+{
+	return get_next_bl_params_from_mem_params_desc();
+}
