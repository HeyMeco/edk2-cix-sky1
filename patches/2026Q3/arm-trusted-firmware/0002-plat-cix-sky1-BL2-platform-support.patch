+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * BL2 image storage on Sky1: the SPI NOR behind the Cadence xSPI controller.
+ *
+ * The flash holds two FIPs: bootloader2 (BL31, BL32 and their certificates)
+ * and bootloader3 (BL33 and its certificates, including the CIX
+ * NON_TRUSTED_KEY_CERT_ID trusted key certificate).  Their offsets come from
+ * the firmware header that cix_package_tool writes at 1 MiB (2 MiB when the
+ * boot ROM reports the second copy), with the CIX defaults as a fallback.
+ */
+
+#include <assert.h>
+#include <string.h>
+
+#include <common/debug.h>
+#include <drivers/io/io_driver.h>
+#include <drivers/io/io_fip.h>
+#include <drivers/io/io_mtd.h>
+#include <drivers/io/io_storage.h>
+#include <drivers/spi_mem.h>
+#include <drivers/spi_nor.h>
+#include <lib/mmio.h>
+#include <lib/utils.h>
+#include <plat/common/platform.h>
+#include <tools_share/firmware_image_package.h>
+
+#include <plat_cix.h>
+#include <platform_def.h>
+
+/* Firmware header (cix_package_tool) */
+#define CIX_FW_HEADER_MAGIC		0x55AA55AAU
+#define CIX_FW_HEADER_BASE		0x100000U
+#define CIX_FW_HEADER_BASE_ALT		0x200000U
+#define CIX_FW_HEADER_MAX_ENTRIES	256U
+#define CIX_FW_TYPE_BOOTLOADER2		2U
+#define CIX_FW_TYPE_BOOTLOADER3		7U
+/* Bit 0: the boot ROM booted from the copy whose header is at 2 MiB */
+#define CIX_BOOT_COPY_STATUS_REG	0x05040060U
+
+/* Supported SPI flash table in bootloader1, read by the boot ROM as well */
+#define CIX_BL1_FLASH_TABLE		0x188800U
+#define CIX_BL1_FLASH_TABLE_ENTRY	16U
+#define CIX_BL1_FLASH_TABLE_MAX		64U
+
+/* xSPI pads: switch the IOMUX to the FCH xSPI controller */
+#define CIX_IOMUX_S5_XSPI_PADS		0x160070F0U
+#define CIX_IOMUX_S5_XSPI_PAD_CNT	6U
+#define CIX_IOMUX_S5_XSPI_FUNC		0xDCU
+
+#define SKY1_SPI_NOR_SIZE		0x1000000U
+
+/* Cadence xSPI driver (drivers/cadence/xspi/xspi.c) */
+int cdns_xspi_init(void);
+void set_xspi_bus_clock(uint8_t xspi_clk_index);
+
+typedef struct {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t count;
+	uint32_t reserved;
+	struct {
+		uint32_t type;
+		uint32_t address;
+		uint32_t length;
+		uint32_t reserved;
+	} entry[CIX_FW_HEADER_MAX_ENTRIES];
+} cix_fw_header_t;
+
+static cix_fw_header_t fw_header;
+
+static const io_dev_connector_t *fip_dev_con;
+static uintptr_t fip_dev_handle;
+static uintptr_t fip_uefi_dev_handle;
+
+static const io_dev_connector_t *mtd_dev_con;
+static uintptr_t mtd_dev_handle;
+
+static io_mtd_dev_spec_t spi_nor_dev_spec = {
+	.ops = {
+		.init = spi_nor_init,
