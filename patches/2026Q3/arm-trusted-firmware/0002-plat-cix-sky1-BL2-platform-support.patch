+	},
+	[TRUSTED_OS_FW_KEY_CERT_ID] = {
+		&fip_dev_handle, (uintptr_t)&tos_fw_key_cert_uuid_spec,
+		open_fip
+	},
+	[SOC_FW_CONTENT_CERT_ID] = {
+		&fip_dev_handle, (uintptr_t)&soc_fw_cert_uuid_spec, open_fip
+	},
+	[TRUSTED_OS_FW_CONTENT_CERT_ID] = {
+		&fip_dev_handle, (uintptr_t)&tos_fw_cert_uuid_spec, open_fip
+	},
+	/* bootloader3 carries its own trusted key certificate */
+	[NON_TRUSTED_KEY_CERT_ID] = {
+		&fip_uefi_dev_handle, (uintptr_t)&trusted_key_cert_uuid_spec,
+		open_fip_uefi
+	},
+	[NON_TRUSTED_FW_KEY_CERT_ID] = {
+		&fip_uefi_dev_handle, (uintptr_t)&nt_fw_key_cert_uuid_spec,
+		open_fip_uefi
+	},
+	[NON_TRUSTED_FW_CONTENT_CERT_ID] = {
+		&fip_uefi_dev_handle, (uintptr_t)&nt_fw_cert_uuid_spec,
+		open_fip_uefi
+	},
+#endif /* TRUSTED_BOARD_BOOT */
+};
+
+static int open_fip_dev(uintptr_t dev_handle, unsigned int backend_id,
+			const uintptr_t spec)
+{
+	uintptr_t local_image_handle;
+	int result;
+
+	result = io_dev_init(dev_handle, (uintptr_t)backend_id);
+	if (result == 0) {
+		result = io_open(dev_handle, spec, &local_image_handle);
+		if (result == 0) {
+			io_close(local_image_handle);
+		}
+	}
+	return result;
+}
+
+static int open_fip(const uintptr_t spec)
+{
+	return open_fip_dev(fip_dev_handle, FIP_IMAGE_ID, spec);
+}
+
+static int open_fip_uefi(const uintptr_t spec)
+{
+	return open_fip_dev(fip_uefi_dev_handle, FIP_UEFI_IMAGE_ID, spec);
+}
+
+static int open_mtd(const uintptr_t spec)
+{
+	uintptr_t local_image_handle;
+	int result;
+
+	result = io_dev_init(mtd_dev_handle, (uintptr_t)NULL);
+	if (result == 0) {
+		result = io_open(mtd_dev_handle, spec, &local_image_handle);
+		if (result == 0) {
+			io_close(local_image_handle);
+		}
+	}
+	return result;
+}
+
+/*
+ * Read command for the SPI NOR from the bootloader1 flash table, as the CIX
+ * BL2 does: each 16-byte entry holds the JEDEC ID (byte-reversed in bytes
+ * 0-2), the xSPI clock index (byte 4), the data bus mode (byte 5, 2: quad)
+ * and the dummy cycles (byte 6).  Flashes not in the table use single-line
+ * reads at the default clock.
+ */
+int plat_get_nor_data(struct nor_device *device)
+{
+	uint8_t id[3] = { 0 };
+	uint8_t table[CIX_BL1_FLASH_TABLE_ENTRY * CIX_BL1_FLASH_TABLE_MAX];
+	uint8_t count = 0;
+	struct spi_mem_op op;
+	uint8_t clk_index = 0;
+	unsigned int i;
+	int ret;
+
+	device->size = SKY1_SPI_NOR_SIZE;
+
+	zeromem(&op, sizeof(op));
+	op.cmd.opcode = SPI_NOR_OP_READ_ID;
+	op.cmd.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.dir = SPI_MEM_DATA_IN;
+	op.data.nbytes = sizeof(id);
+	op.data.buf = id;
+	ret = spi_mem_exec_op(&op);
+
+	zeromem(&op, sizeof(op));
+	op.cmd.opcode = SPI_NOR_OP_READ;
+	op.cmd.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.addr.nbytes = 3U;
+	op.addr.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.addr.val = CIX_BL1_FLASH_TABLE;
+	op.data.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.dir = SPI_MEM_DATA_IN;
+	op.data.nbytes = 1U;
+	op.data.buf = &count;
+	if ((ret == 0) && (spi_mem_exec_op(&op) == 0) && (count != 0U)) {
+		if (count > CIX_BL1_FLASH_TABLE_MAX) {
+			count = CIX_BL1_FLASH_TABLE_MAX;
+		}
+		op.addr.val = CIX_BL1_FLASH_TABLE + 4U;
+		op.data.nbytes = count * CIX_BL1_FLASH_TABLE_ENTRY;
+		op.data.buf = table;
+		if (spi_mem_exec_op(&op) == 0) {
+			for (i = 0U; i < count; i++) {
+				const uint8_t *e = &table[i * CIX_BL1_FLASH_TABLE_ENTRY];
+
+				if ((e[2] != id[0]) || (e[1] != id[1]) ||
+				    (e[0] != id[2])) {
+					continue;
+				}
+				clk_index = e[4];
+				if (e[5] == 2U) {
+					device->read_op.data.buswidth =
+						SPI_MEM_BUSWIDTH_4_LINE;
+				}
+				device->read_op.dummy.nbytes = e[6] >> 3;
+				INFO("SPI NOR %02x%02x%02x: clock %u, mode %u, %u dummy cycles\n",
+				     id[0], id[1], id[2], e[4], e[5], e[6]);
+				break;
+			}
+		}
+	}
+
+	set_xspi_bus_clock(clk_index);
+	return 0;
+}
+
+static int cix_xspi_init(void)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0U; i < CIX_IOMUX_S5_XSPI_PAD_CNT; i++) {
+		mmio_write_32(CIX_IOMUX_S5_XSPI_PADS + 4U * i,
+			      CIX_IOMUX_S5_XSPI_FUNC);
+	}
+	ret = cdns_xspi_init();
+	if (ret < 0) {
+		ERROR("CIX: xspi init failed\n");
+	}
+	return ret;
+}
+
+static int cix_fw_header_find(uint32_t type, io_block_spec_t *spec)
+{
+	unsigned int i;
+
+	for (i = 0U; i < fw_header.count && i < CIX_FW_HEADER_MAX_ENTRIES; i++) {
+		if (fw_header.entry[i].type == type) {
+			spec->offset = fw_header.entry[i].address;
+			spec->length = fw_header.entry[i].length;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static int cix_read_fw_header(void)
+{
+	uint32_t base = CIX_FW_HEADER_BASE;
+	size_t length = 0U;
+	int ret;
+
+	if ((mmio_read_32(CIX_BOOT_COPY_STATUS_REG) & 1U) != 0U) {
+		base = CIX_FW_HEADER_BASE_ALT;
+	}
+	ret = spi_nor_read(base, (uintptr_t)&fw_header, sizeof(fw_header),
+			   &length);
+	if ((ret != 0) || (length != sizeof(fw_header)) ||
+	    (fw_header.magic != CIX_FW_HEADER_MAGIC)) {
+		return -1;
+	}
+	if ((cix_fw_header_find(CIX_FW_TYPE_BOOTLOADER2, &fip_block_spec) != 0) ||
+	    (cix_fw_header_find(CIX_FW_TYPE_BOOTLOADER3, &fip_uefi_block_spec) != 0)) {
+		return -1;
+	}
+	return 0;
+}
+
+int cix_io_setup(void)
+{
+	int io_result;
+
+	io_result = register_io_dev_fip(&fip_dev_con);
+	if (io_result < 0) {
+		return io_result;
+	}
+	io_result = io_dev_open(fip_dev_con, (uintptr_t)NULL, &fip_dev_handle);
+	if (io_result < 0) {
+		return io_result;
+	}
+	io_result = io_dev_open(fip_dev_con, (uintptr_t)NULL,
+				&fip_uefi_dev_handle);
+	if (io_result < 0) {
+		return io_result;
+	}
+
+	io_result = cix_xspi_init();
+	if (io_result < 0) {
+		return io_result;
+	}
+	io_result = register_io_dev_mtd(&mtd_dev_con);
+	if (io_result < 0) {
+		return io_result;
+	}
+	io_result = io_dev_open(mtd_dev_con, (uintptr_t)&spi_nor_dev_spec,
+				&mtd_dev_handle);
+	if (io_result < 0) {
+		return io_result;
+	}
+
+	if (cix_read_fw_header() != 0) {
+		WARN("get bootloader address from cix_flash_all.bin header fail, use deault value\n");
+		fip_block_spec.offset = PLAT_CIX_SPI_NOR_FIP_IMAGE_BASE;
+		fip_block_spec.length = PLAT_CIX_SPI_NOR_FLASH_IMAGE_MAX_SIZE;
+		fip_uefi_block_spec.offset = PLAT_CIX_SPI_NOR_FIP_UEFI_IMAGE_BASE;
+		fip_uefi_block_spec.length = PLAT_CIX_SPI_NOR_FLASH_IMAGE_MAX_SIZE;
+	}
+	INFO("bootloader2 at 0x%lx, bootloader3 at 0x%lx\n",
+	     fip_block_spec.offset, fip_uefi_block_spec.offset);
+	return 0;
+}
+
+void plat_cix_io_setup(void)
+{
+	if (cix_io_setup() != 0) {
+		ERROR("BL2: cannot set up the boot flash\n");
+		panic();
+	}
+}
+
+/* Return an IO device handle and specification which can be used to access
+ * an image. Use this to enforce platform load policy */
+int plat_get_image_source(unsigned int image_id, uintptr_t *dev_handle,
+			  uintptr_t *image_spec)
+{
+	const struct plat_io_policy *policy;
+	int result;
+
+	assert(image_id < ARRAY_SIZE(policies));
+
+	policy = &policies[image_id];
+	if (policy->check == NULL) {
+		return -ENOENT;
+	}
+	result = policy->check(policy->image_spec);
+	if (result != 0) {
+		return result;
+	}
+
+	*image_spec = policy->image_spec;
+	*dev_handle = *(policy->dev_handle);
+	return 0;
+}
+
+/*
+ * Boot-time configuration items the SE leaves in csec_km_meta_t.boot_cfg:
+ * 16-byte entries of a NUL-terminated name and a 32-bit value.
+ */
+uint32_t btcfg_get_value(void *base, char *item, uint32_t *value)
+{
+	const mntr_boot_cfg_item *cfg = base;
+	unsigned int i;
+
+	for (i = 0U; i < BOOT_CFG_MAX / sizeof(*cfg); i++) {
+		if (cfg[i].cmd_string[0] == '\0') {
+			break;
+		}
+		if (strncmp(cfg[i].cmd_string, item, CMD_STR_MAX) == 0) {
+			*value = cfg[i].val;
+			return 0;
+		}
+	}
+	return 0x9101U;
+}
+
+/* The images always come from the boot flash. */
+bool cix_bl_mode_is_backdoor(void)
+{
+	return false;
+}
diff --git a/plat/cix/sky1/platform.mk b/plat/cix/sky1/platform.mk
index 1ffab7574..de79f2086 100644
--- a/plat/cix/sky1/platform.mk
+++ b/plat/cix/sky1/platform.mk
@@ -100,6 +100,23 @@ override ARM_PLAT_MT	:=	0
 # Using cix csec lib for trust boot and image parse
 CIX_SEC_LIB := 1
 
+ifneq (${TRUSTED_BOARD_BOOT},0)
+# The CIX crypto-engine library is not public: verify with mbed TLS
+include drivers/auth/mbedtls/mbedtls_crypto.mk
+include drivers/auth/mbedtls/mbedtls_x509.mk
+
+# Root of trust: SHA-256 of the ROT_KEY public key, built into BL2
+ifndef ROT_KEY
+$(error TRUSTED_BOARD_BOOT needs ROT_KEY, the root of trust key (PEM))
+endif
+SKY1_ROTPK_HASH		:=	$(BUILD_PLAT)/sky1_rotpk_sha256.bin
+$(eval $(call add_define_val,SKY1_ROTPK_HASH,'"$(SKY1_ROTPK_HASH)"'))
+BL2_SOURCES		+=	plat/cix/sky1/sky1_rotpk.S
+$(BUILD_PLAT)/bl2/sky1_rotpk.o: $(SKY1_ROTPK_HASH)
+$(SKY1_ROTPK_HASH): $(ROT_KEY) FORCE | $(BUILD_PLAT)
+	openssl pkey -in $< -pubout -outform DER | openssl dgst -sha256 -binary > $@
+endif
+
 SKY1_BASE	=	plat/cix/sky1
 
 PLAT_INCLUDES		+=	-I${SKY1_BASE}/include/	\
diff --git a/plat/cix/sky1/sky1_bl2_el3_setup.c b/plat/cix/sky1/sky1_bl2_el3_setup.c
new file mode 100644
index 000000000..7a63b907c
--- /dev/null
+++ b/plat/cix/sky1/sky1_bl2_el3_setup.c
@@ -0,0 +1,115 @@
+/*
+ * Copyright (c) 2017-2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * BL2 at EL3 on Sky1.  The SE firmware has trained DRAM, loaded BL2 to
+ * BL2_BASE and left two things for it: the key-management block at
+ * OEM_ROTPK_DDR_BASE_ADDRESS_AP and the DRAM description at
+ * MEM_OUTPUT_BUFFER_ADDR.  BL2 sets up the console, the boot flash and the
+ * MMU, programs the TZC-400s and loads BL31, OP-TEE and UEFI.
+ */
+
+#include <string.h>
+
+#include <arch_helpers.h>
+#include <common/bl_common.h>
+#include <common/debug.h>
+#include <drivers/generic_delay_timer.h>
+#include <lib/rlog.h>
+#include <lib/xlat_tables/xlat_tables_compat.h>
+#include <plat/common/platform.h>
+
+#include <cix_fw_boot_perf.h>
+#include <drivers/watchdog.h>
+#include <plat_cix.h>
+#include <platform_def.h>
+
+static const mmap_region_t sky1_bl2_mmap[] = {
+	SKY1_MAP_DEVICE,
+	MAP_REGION_FLAT(BL31_BASE, BL31_LIMIT - BL31_BASE,
+			MT_MEMORY | MT_RW | MT_SECURE),
+	MAP_REGION_FLAT(BL32_BASE, BL32_LIMIT - BL32_BASE,
+			MT_MEMORY | MT_RW | MT_SECURE),
+	{0}
+};
+
+#if RAM_LOG_SUPPORT
+static unsigned long long sky1_rlog_get_tick(void)
+{
+	return read_cntpct_el0();
+}
+
+/* BL2 log in DRAM, shown by UEFI's RamLogDumpDxe as BL31's is */
+static ramlog_ops sky1_bl2_rlog_ops = {
+	.flush = flush_dcache_range,
+	.get_tick = sky1_rlog_get_tick,
+};
+#endif
+
+void bl2_el3_early_platform_setup(u_register_t arg0 __unused,
+				  u_register_t arg1 __unused,
+				  u_register_t arg2 __unused,
+				  u_register_t arg3 __unused)
+{
+	cix_boot_perf_init(PBL_PHASE);
+	cix_set_boot_phase(PBL_PHASE, RECORD_START);
+
+	cix_console_boot_init();
+	generic_delay_timer_init();
+
+	plat_cix_io_setup();
+
+	/* Shown by UEFI next to the BL31 version */
+	strlcpy((void *)BL2_SHMEM_VER_STR, shmem_version_string,
+		SHMEM_VER_STR_LEN);
+
+	plat_watchdog_init();
+}
+
+void bl2_el3_plat_arch_setup(void)
+{
+	const mmap_region_t bl_regions[] = {
+		MAP_REGION_FLAT(BL2_BASE, BL2_END - BL2_BASE,
+				MT_MEMORY | MT_RW | MT_SECURE),
+		MAP_REGION_FLAT(BL_CODE_BASE, BL_CODE_END - BL_CODE_BASE,
+				MT_CODE | MT_SECURE),
+		MAP_REGION_FLAT(BL_RO_DATA_BASE,
+				BL_RO_DATA_END - BL_RO_DATA_BASE,
+				MT_RO_DATA | MT_SECURE),
+		/* SE key-management block (ROTPK hash, boot config) */
+		MAP_REGION_FLAT(OEM_ROTPK_DDR_BASE_ADDRESS_AP, PAGE_SIZE,
+				MT_DEVICE | MT_RW | MT_SECURE),
+		{0}
+	};
+	MEM_INIT_OUTPUT_BUFFER *mem = GetMemOutputBuffer();
+	unsigned long long ns_size;
+
+	/* Non-secure DRAM below 4 GiB that BL2 loads UEFI into */
+	ns_size = (unsigned long long)mem->AvailableSize * 0x100000ULL;
+	ns_size -= SKY1_TZC_DRAM1_SIZE;
+	mmap_add_region(SKY1_NS_DRAM1_BASE, SKY1_NS_DRAM1_BASE, ns_size,
+			MT_MEMORY | MT_RW | MT_SECURE);
+
+	setup_page_tables(bl_regions, sky1_bl2_mmap);
+	enable_mmu_el3(0);
+
+#if RAM_LOG_SUPPORT
+	rlog_init_printf((char *)RAM_LOG_BL2_ADDR, RAM_LOG_BL2_SIZE,
+			 &sky1_bl2_rlog_ops);
+#endif
+}
+
+/* Runs before the first image marked IMAGE_ATTRIB_PLAT_SETUP (BL31) */
+void bl2_platform_setup(void)
+{
+	plat_cix_security_setup();
+}
+
+void bl2_el3_plat_prepare_exit(void)
+{
+	cix_set_boot_phase(PBL_PHASE, RECORD_END);
+	cix_boot_perf_uninit(PBL_PHASE);
+}
diff --git a/plat/cix/sky1/sky1_rotpk.S b/plat/cix/sky1/sky1_rotpk.S
new file mode 100644
index 000000000..ee90a9036
--- /dev/null
+++ b/plat/cix/sky1/sky1_rotpk.S
@@ -0,0 +1,20 @@
+/*
+ * Copyright (c) 2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * Root of trust public key hash as a DER DigestInfo (SHA-256), the form
+ * plat_get_rotpk_info() returns with ROTPK_IS_HASH.  SKY1_ROTPK_HASH is the
+ * 32-byte hash file generated from ROT_KEY (platform.mk).
+ */
+	.global sky1_rotpk_hash_der_header
+	.global sky1_rotpk_hash_der_end
+	.section .rodata.sky1_rotpk_hash, "a"
+
+sky1_rotpk_hash_der_header:
+	.byte 0x30, 0x31, 0x30, 0x0D, 0x06, 0x09, 0x60, 0x86, 0x48
+	.byte 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20
+	.incbin SKY1_ROTPK_HASH
+sky1_rotpk_hash_der_end:
diff --git a/plat/cix/sky1/sky1_trusted_boot.c b/plat/cix/sky1/sky1_trusted_boot.c
new file mode 100644
index 000000000..c099d1ed1
--- /dev/null
+++ b/plat/cix/sky1/sky1_trusted_boot.c
@@ -0,0 +1,47 @@
+/*
+ * Copyright (c) 2015-2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * Trusted board boot on Sky1.
+ *
+ * Root of trust: the SHA-256 of the ROT_KEY public key, built into BL2
+ * (sky1_rotpk.S).  It anchors both FIPs: bootloader2's trusted key
+ * certificate and bootloader3's (NON_TRUSTED_KEY_CERT_ID, see cix_cot_bl2.c).
+ * The CIX BL2 instead takes a hash the SE leaves in the key-management block
+ * and authenticates nothing on chips without secure boot fused; this BL2 is
+ * signed into bootloader1 by the board owner, so its built-in key is the
+ * trust anchor.
+ *
+ * There is no rollback protection: the NV counters read 0 and are not
+ * updated, as in the CIX BL2.
+ */
+
+#include <stdint.h>
+
+#include <plat/common/platform.h>
+
+extern unsigned char sky1_rotpk_hash_der_header[];
+extern unsigned char sky1_rotpk_hash_der_end[];
+
+int plat_get_rotpk_info(void *cookie __unused, void **key_ptr,
+			unsigned int *key_len, unsigned int *flags)
+{
+	*key_ptr = sky1_rotpk_hash_der_header;
+	*key_len = sky1_rotpk_hash_der_end - sky1_rotpk_hash_der_header;
+	*flags = ROTPK_IS_HASH;
+	return 0;
+}
+
+int plat_get_nv_ctr(void *cookie __unused, unsigned int *nv_ctr)
+{
+	*nv_ctr = 0U;
+	return 0;
+}
+
+int plat_set_nv_ctr(void *cookie __unused, unsigned int nv_ctr __unused)
+{
+	return 0;
+}
