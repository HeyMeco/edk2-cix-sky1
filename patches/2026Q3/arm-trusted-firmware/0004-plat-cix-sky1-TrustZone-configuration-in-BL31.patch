diff --git a/plat/cix/sky1/sky1_tz_config.c b/plat/cix/sky1/sky1_tz_config.c
new file mode 100644
index 000000000..5e045c18d
--- /dev/null
+++ b/plat/cix/sky1/sky1_tz_config.c
@@ -0,0 +1,200 @@
+/*
+ * Copyright (c) 2026, edk2-cix contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * TrustZone configuration on Sky1: trustzone_config.bin, written by the CIX
+ * trustzone_config tool (edk2-non-osi PackageTool/trustzone_config) and
+ * placed in the boot flash as firmware header image type 9.  BL31 reads it
+ * once, falls back to the defaults when it is missing or invalid, keeps SPE
+ * from the non-secure world when it says so, and leaves the data bytes at
+ * SKY1_TZ_CONFIG_SHM_BASE for the secure OS (secure storage location,
+ * bootloader3 recovery), as the CIX BL31 does.
+ */
+
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <common/debug.h>
+#include <drivers/spi_nor.h>
+#include <lib/utils.h>
+#include <lib/utils_def.h>
+#include <plat/common/platform.h>
+
+#include <plat_cix.h>
+#include <platform_def.h>
+
+#define TZ_CONFIG_FW_TYPE		9U
+#define TZ_CONFIG_SIGNATURE		0x46435A54U	/* "TZCF" */
+#define TZ_CONFIG_VERSION_MAJOR		1U
+#define TZ_CONFIG_VERSION_MINOR		0U
+
+#define SEC_STORAGE_TYPE_NOF_DISABLED	0x00U
+#define SEC_STORAGE_TYPE_NOF_ENABLED	0x01U
+
+/* trustzone_export_config.h */
+typedef struct {
+	uint8_t spe_feature_en;
+	uint8_t secure_storage_type;
+	uint32_t secure_storage_addr;
+	uint32_t secure_storage_size;
+	uint8_t bl3_backup_recovery_en;
+} __packed tz_config_data_t;
+
+typedef struct {
+	uint16_t version_major;
+	uint16_t version_minor;
+	uint32_t timestamp;
+	uint32_t length;		/* checksummed bytes, from version_major */
+	uint32_t signature;
+	uint32_t crc1;
+	uint32_t crc2;
+	uint8_t version_id;
+	uint8_t config_length;		/* version_id to the end of data */
+	tz_config_data_t data;
+} __packed tz_config_t;
+
+CASSERT(sizeof(tz_config_data_t) == 11U, assert_tz_config_data_size);
+
+/*
+ * The CIX tool writes 40 bytes (13 bytes of configuration).  The Radxa
+ * Orion O6 file comes from an older tool without bl3_backup_recovery_en:
+ * 36 bytes, 12 of configuration.  The CIX BL31 checks the first `length`
+ * bytes either way.
+ */
+#define TZ_CONFIG_MIN_DATA	offsetof(tz_config_data_t, bl3_backup_recovery_en)
+#define TZ_CONFIG_MIN_LENGTH	(offsetof(tz_config_t, data) + TZ_CONFIG_MIN_DATA)
+#define TZ_CONFIG_MAX_LENGTH	64U
+
+/* Used when the flash has none: SPE on, no secure storage, no recovery */
+static tz_config_data_t tz_config = {
+	.spe_feature_en = 1U,
+};
+
+/*
+ * Fletcher-style sums over 32-bit words with both checksum fields zero, as
+ * the trustzone_config tool computes them.
+ */
+static bool tz_config_checksum_ok(const uint32_t *raw, uint32_t length)
+{
+	const tz_config_t *cfg = (const void *)raw;
+	unsigned int crc1 = offsetof(tz_config_t, crc1) / sizeof(uint32_t);
+	unsigned int crc2 = offsetof(tz_config_t, crc2) / sizeof(uint32_t);
+	uint32_t a = 0U, b = 0U;
+	unsigned int i;
+
+	for (i = 0U; i < length / sizeof(uint32_t); i++) {
+		a += ((i == crc1) || (i == crc2)) ? 0U : raw[i];
+		b += a;
+	}
+	return (a == cfg->crc1) && (b == cfg->crc2);
+}
+
+static int tz_config_read(tz_config_data_t *data)
+{
+	uint32_t raw[TZ_CONFIG_MAX_LENGTH / sizeof(uint32_t)];
+	const tz_config_t *cfg = (const void *)raw;
+	size_t offset, length, read = 0U;
+	size_t data_len;
+
+	/* Only the Orion O6/O6N layouts have one */
+	if (cix_fw_header_find(TZ_CONFIG_FW_TYPE, &offset, &length) != 0) {
+		INFO("TrustZone: no configuration in the flash, using the defaults\n");
+		return -ENOENT;
+	}
+	if ((length < sizeof(raw)) ||
+	    (spi_nor_read(offset, (uintptr_t)raw, sizeof(raw), &read) != 0) ||
+	    (read != sizeof(raw))) {
+		ERROR("TrustZone: cannot read the configuration at 0x%zx\n",
+		      offset);
+		return -1;
+	}
+	if (cfg->signature != TZ_CONFIG_SIGNATURE) {
+		ERROR("TrustZone: invalid signature 0x%08x\n", cfg->signature);
+		return -1;
+	}
+	if ((cfg->version_major != TZ_CONFIG_VERSION_MAJOR) ||
+	    (cfg->version_minor != TZ_CONFIG_VERSION_MINOR) ||
+	    (cfg->version_id != TZ_CONFIG_VERSION_MAJOR)) {
+		ERROR("TrustZone: unsupported version %u.%u/%u\n",
+		      cfg->version_major, cfg->version_minor, cfg->version_id);
+		return -1;
+	}
+	if ((cfg->length < TZ_CONFIG_MIN_LENGTH) ||
+	    (cfg->length > sizeof(raw)) || ((cfg->length % 4U) != 0U) ||
+	    !tz_config_checksum_ok(raw, cfg->length)) {
+		ERROR("TrustZone: checksum failed\n");
+		return -1;
+	}
+
+	/* version_id and config_length count; fields the file lacks stay 0 */
+	if (cfg->config_length < 2U + TZ_CONFIG_MIN_DATA) {
+		ERROR("TrustZone: configuration length %u\n", cfg->config_length);
+		return -1;
+	}
+	data_len = MIN((size_t)cfg->config_length - 2U, sizeof(*data));
+	if (offsetof(tz_config_t, data) + data_len > cfg->length) {
+		ERROR("TrustZone: configuration length %u\n", cfg->config_length);
+		return -1;
+	}
+	zeromem(data, sizeof(*data));
+	memcpy(data, &cfg->data, data_len);
+	return 0;
+}
+
+/* Needs the boot flash (cix_qspi_init) */
+void sky1_tz_config_setup(void)
+{
+	unsigned long long size;
+	unsigned int erase_size;
+	tz_config_data_t data;
+	int ret = -EIO;
+
+	if (spi_nor_init(&size, &erase_size) == 0) {
+		ret = tz_config_read(&data);
+	}
+	if (ret == 0) {
+		tz_config = data;
+	} else if (ret != -ENOENT) {
+		WARN("TrustZone: flash configuration invalid, using the defaults\n");
+	}
+
+	/*
+	 * The secure OS writes its NOR file system there: never over the boot
+	 * firmware.  (The Radxa O6 configuration puts it at 6 MiB, where a
+	 * bootloader3 larger than 1.9 MiB already is.)
+	 */
+	if ((tz_config.secure_storage_type == SEC_STORAGE_TYPE_NOF_ENABLED) &&
+	    ((tz_config.secure_storage_size == 0U) ||
+	     cix_fw_header_overlaps(tz_config.secure_storage_addr,
+				    tz_config.secure_storage_size))) {
+		WARN("TrustZone: secure storage at 0x%x+0x%x overlaps the boot firmware, disabled\n",
+		     tz_config.secure_storage_addr,
+		     tz_config.secure_storage_size);
+		tz_config.secure_storage_type = SEC_STORAGE_TYPE_NOF_DISABLED;
+		tz_config.secure_storage_addr = 0U;
+		tz_config.secure_storage_size = 0U;
+	}
+
+	INFO("TrustZone: SPE %s, secure storage %u at 0x%x+0x%x, bootloader3 recovery %u\n",
+	     plat_spe_for_ns_enabled() ? "on" : "off",
+	     tz_config.secure_storage_type, tz_config.secure_storage_addr,
+	     tz_config.secure_storage_size, tz_config.bl3_backup_recovery_en);
+
+	/* For the secure OS */
+	memcpy((void *)SKY1_TZ_CONFIG_SHM_BASE, &tz_config, sizeof(tz_config));
+}
+
+/*
+ * 0x01 is on; 0x00 and 0xff are off (trustzone_export_config.h).  The CIX
+ * BL31 takes any non-zero value as on; its tool never writes 0xff.
+ */
+bool plat_spe_for_ns_enabled(void)
+{
+	return tz_config.spe_feature_en == 1U;
+}
