diff --git a/plat/cix/common/cix_spi_nor.c b/plat/cix/common/cix_spi_nor.c
new file mode 100644
index 000000000..f0c43fe68
--- /dev/null
+++ b/plat/cix/common/cix_spi_nor.c
@@ -0,0 +1,195 @@
+/*
+ * Copyright (c) 2015-2022, ARM Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+/*
+ * The Sky1 boot flash: a SPI NOR behind the Cadence xSPI controller, read by
+ * BL2 (the FIPs) and BL31 (the TrustZone configuration) through spi_nor.c.
+ * What is where comes from the firmware header that cix_package_tool writes
+ * at 1 MiB (2 MiB when the boot ROM reports the second copy).
+ */
+
+#include <string.h>
+
+#include <common/debug.h>
+#include <drivers/spi_mem.h>
+#include <drivers/spi_nor.h>
+#include <lib/mmio.h>
+#include <lib/utils.h>
+
+#include <plat_cix.h>
+
+/* Firmware header (cix_package_tool) */
+#define CIX_FW_HEADER_MAGIC		0x55AA55AAU
+#define CIX_FW_HEADER_BASE		0x100000U
+#define CIX_FW_HEADER_BASE_ALT		0x200000U
+#define CIX_FW_HEADER_MAX_ENTRIES	256U
+/* Bit 0: the boot ROM booted from the copy whose header is at 2 MiB */
+#define CIX_BOOT_COPY_STATUS_REG	0x05040060U
+
+/* Supported SPI flash table in bootloader1, read by the boot ROM as well */
+#define CIX_BL1_FLASH_TABLE		0x188800U
+#define CIX_BL1_FLASH_TABLE_ENTRY	16U
+#define CIX_BL1_FLASH_TABLE_MAX		64U
+
+#define SKY1_SPI_NOR_SIZE		0x1000000U
+
+/* Cadence xSPI driver (drivers/cadence/xspi/xspi.c) */
+void set_xspi_bus_clock(uint8_t xspi_clk_index);
+
+typedef struct {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t count;
+	uint32_t reserved;
+	struct {
+		uint32_t type;
+		uint32_t address;
+		uint32_t length;
+		uint32_t reserved;
+	} entry[CIX_FW_HEADER_MAX_ENTRIES];
+} cix_fw_header_t;
+
+static cix_fw_header_t fw_header;
+static uint32_t fw_header_base;
+static bool fw_header_valid;
+
+/*
+ * Read command for the SPI NOR from the bootloader1 flash table, as the CIX
+ * BL2 and BL31 do: each 16-byte entry holds the JEDEC ID (byte-reversed in
+ * bytes 0-2), the xSPI clock index (byte 4), the data bus mode (byte 5,
+ * 2: quad) and the dummy cycles (byte 6).  Flashes not in the table use
+ * single-line reads at the default clock.
+ */
+int plat_get_nor_data(struct nor_device *device)
+{
+	uint8_t id[3] = { 0 };
+	uint8_t table[CIX_BL1_FLASH_TABLE_ENTRY * CIX_BL1_FLASH_TABLE_MAX];
+	uint8_t count = 0;
+	struct spi_mem_op op;
+	uint8_t clk_index = 0;
+	unsigned int i;
+	int ret;
+
+	device->size = SKY1_SPI_NOR_SIZE;
+
+	zeromem(&op, sizeof(op));
+	op.cmd.opcode = SPI_NOR_OP_READ_ID;
+	op.cmd.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.dir = SPI_MEM_DATA_IN;
+	op.data.nbytes = sizeof(id);
+	op.data.buf = id;
+	ret = spi_mem_exec_op(&op);
+
+	zeromem(&op, sizeof(op));
+	op.cmd.opcode = SPI_NOR_OP_READ;
+	op.cmd.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.addr.nbytes = 3U;
+	op.addr.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.addr.val = CIX_BL1_FLASH_TABLE;
+	op.data.buswidth = SPI_MEM_BUSWIDTH_1_LINE;
+	op.data.dir = SPI_MEM_DATA_IN;
+	op.data.nbytes = 1U;
+	op.data.buf = &count;
+	if ((ret == 0) && (spi_mem_exec_op(&op) == 0) && (count != 0U)) {
+		if (count > CIX_BL1_FLASH_TABLE_MAX) {
+			count = CIX_BL1_FLASH_TABLE_MAX;
+		}
+		op.addr.val = CIX_BL1_FLASH_TABLE + 4U;
+		op.data.nbytes = count * CIX_BL1_FLASH_TABLE_ENTRY;
+		op.data.buf = table;
+		if (spi_mem_exec_op(&op) == 0) {
+			for (i = 0U; i < count; i++) {
+				const uint8_t *e = &table[i * CIX_BL1_FLASH_TABLE_ENTRY];
+
+				if ((e[2] != id[0]) || (e[1] != id[1]) ||
+				    (e[0] != id[2])) {
+					continue;
+				}
+				clk_index = e[4];
+				if (e[5] == 2U) {
+					device->read_op.data.buswidth =
+						SPI_MEM_BUSWIDTH_4_LINE;
+				}
+				device->read_op.dummy.nbytes = e[6] >> 3;
+				INFO("SPI NOR %02x%02x%02x: clock %u, mode %u, %u dummy cycles\n",
+				     id[0], id[1], id[2], e[4], e[5], e[6]);
+				break;
+			}
+		}
+	}
+
+	set_xspi_bus_clock(clk_index);
+	return 0;
+}
+
+/* Needs spi_nor_init() done */
+static int cix_read_fw_header(void)
+{
+	uint32_t base = CIX_FW_HEADER_BASE;
+	size_t length = 0U;
+	int ret;
+
+	if ((mmio_read_32(CIX_BOOT_COPY_STATUS_REG) & 1U) != 0U) {
+		base = CIX_FW_HEADER_BASE_ALT;
+	}
+	ret = spi_nor_read(base, (uintptr_t)&fw_header, sizeof(fw_header),
+			   &length);
+	if ((ret != 0) || (length != sizeof(fw_header)) ||
+	    (fw_header.magic != CIX_FW_HEADER_MAGIC)) {
+		return -1;
+	}
+	fw_header_base = base;
+	fw_header_valid = true;
+	return 0;
+}
+
+/* Flash offset and length of the image of the given type */
+int cix_fw_header_find(uint32_t type, size_t *offset, size_t *length)
+{
+	unsigned int i;
+
+	if (!fw_header_valid && (cix_read_fw_header() != 0)) {
+		return -1;
+	}
+	for (i = 0U; i < fw_header.count && i < CIX_FW_HEADER_MAX_ENTRIES; i++) {
+		if (fw_header.entry[i].type == type) {
+			*offset = fw_header.entry[i].address;
+			*length = fw_header.entry[i].length;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static bool ranges_overlap(size_t a, size_t a_len, size_t b, size_t b_len)
+{
+	return (a < b + b_len) && (b < a + a_len);
+}
+
+/*
+ * Whether [offset, offset + length) touches the boot firmware: everything up
+ * to the end of the firmware header, or an image the header lists.
+ */
+bool cix_fw_header_overlaps(size_t offset, size_t length)
+{
+	unsigned int i;
+
+	if (!fw_header_valid && (cix_read_fw_header() != 0)) {
+		return true;
+	}
+	if (ranges_overlap(offset, length, 0U,
+			   fw_header_base + sizeof(fw_header))) {
+		return true;
+	}
+	for (i = 0U; i < fw_header.count && i < CIX_FW_HEADER_MAX_ENTRIES; i++) {
+		if (ranges_overlap(offset, length, fw_header.entry[i].address,
+				   fw_header.entry[i].length)) {
+			return true;
+		}
+	}
+	return false;
+}
diff --git a/plat/cix/common/include/plat_cix.h b/plat/cix/common/include/plat_cix.h
index 8a32541f4..12b776baf 100644
--- a/plat/cix/common/include/plat_cix.h
+++ b/plat/cix/common/include/plat_cix.h
@@ -204,6 +204,13 @@ int sdei_tee_exception_handler(uint32_t data_len);
 
 uint32_t btcfg_get_value(void *base, char *item, uint32_t *value);
 
+/* Boot flash (cix_spi_nor.c): image location from the firmware header */
+int cix_fw_header_find(uint32_t type, size_t *offset, size_t *length);
+bool cix_fw_header_overlaps(size_t offset, size_t length);
+
+/* TrustZone configuration from the boot flash (BL31) */
+void sky1_tz_config_setup(void);
+
 void cix_set_reboot_reason(uint32_t reason);
 uint32_t cix_get_reboot_reason(void);
 
