From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mecid <mecidi.cc@gmail.com>
Date: Sat, 31 Oct 2026 10:46:13 +0100
Subject: [PATCH] Platform/CIX/Sky1: SetupManagerDxe: show only what the board
 has

Boards without an EC (BOARD_NO_EC in VFRPP_FLAGS) get no EC version, EC
fan mode, light sensor mode or device power control page; boards without
GMAC (BOARD_NO_GMAC) no GMAC page.  The board DSC sets the flags from
I2C_EC_ENABLE and SOC_GMAC_ENABLE, so one setup interface serves every
board instead of per-board copies of SetupManagerDxe.
---
 .../Sky1/Drivers/SetupManagerDxe/PlatformMenu/Platform.hfr  | 6 ++++++
 .../CIX/Sky1/Drivers/SetupManagerDxe/SetupManagerVfr.Vfr    | 4 ++++
 2 files changed, 10 insertions(+)

diff --git a/Platform/CIX/Sky1/Drivers/SetupManagerDxe/PlatformMenu/Platform.hfr b/Platform/CIX/Sky1/Drivers/SetupManagerDxe/PlatformMenu/Platform.hfr
index d0f77a03..20f45ebf 100644
--- a/Platform/CIX/Sky1/Drivers/SetupManagerDxe/PlatformMenu/Platform.hfr
+++ b/Platform/CIX/Sky1/Drivers/SetupManagerDxe/PlatformMenu/Platform.hfr
@@ -83,6 +83,7 @@ endif;
         option text = STRING_TOKEN(STR_ENABLED),  value = 1, flags = RESET_REQUIRED;
       endoneof;
 
+#ifndef BOARD_NO_EC
       oneof varid   = PlatformSetupVar.LightSensorCtrl,
         prompt      = STRING_TOKEN(STR_LIGHT_SENSOR_CONTROL_PROMPT),
         help        = STRING_TOKEN(STR_LIGHT_SENSOR_CONTROL_PROMPT_HELP),
@@ -90,6 +91,7 @@ endif;
         option text = STRING_TOKEN(STR_EC_MODE), value = 0, flags = RESET_REQUIRED;
         option text = STRING_TOKEN(STR_AP_MODE), value = 1, flags = RESET_REQUIRED;
       endoneof;
+#endif
 
       oneof varid   = PlatformSetupVar.SpcrEnable,
         prompt      = STRING_TOKEN(STR_ENABLE_SPCR_TABLE),
@@ -99,6 +101,7 @@ endif;
         option text = STRING_TOKEN(STR_ENABLED), value = 1, flags = RESET_REQUIRED;
       endoneof;
 
+#ifndef BOARD_NO_EC
       oneof varid   = PlatformSetupVar.EcFanMode,
         prompt      = STRING_TOKEN(STR_EC_FAN_MODE_PROMPT),
         help        = STRING_TOKEN(STR_EC_FAN_MODE_PROMPT_HELP),
@@ -106,6 +109,7 @@ endif;
         option text = STRING_TOKEN(STR_AUTO_MODE), value = 0, flags = RESET_REQUIRED;
         option text = STRING_TOKEN(STR_PERF_MODE), value = 1, flags = RESET_REQUIRED;
       endoneof;
+#endif
 #ifdef DEBUG_MODE_SUPPORT
       oneof varid   = PlatformSetupVar.DebugMode,
         prompt      = STRING_TOKEN(STR_DEBUG_MODE_PROMPT),
@@ -136,11 +140,13 @@ suppressif FixedPcdGetBool (PcdBiosBackupRecovery) == FALSE;
       endoneof;
 endif;
 
+#ifndef BOARD_NO_EC
 suppressif ideqval SystemTableVar.SystemTableSelect == 0x01;
       goto DEVICE_POWER_CONTROL_FORM_ID,
         prompt = STRING_TOKEN(STR_DEVICE_POWER_CONTROL_FORM_TITLE),
         help   = STRING_TOKEN(STR_DEVICE_POWER_CONTROL_FORM_TITLE_HELP);
 endif;
+#endif
 suppressif TRUE;
       goto CLOCK_GATING_CONTROL_FORM_ID,
         prompt = STRING_TOKEN(STR_CLOCK_GATING_CONTROL_FORM_TITLE),
diff --git a/Platform/CIX/Sky1/Drivers/SetupManagerDxe/SetupManagerVfr.Vfr b/Platform/CIX/Sky1/Drivers/SetupManagerDxe/SetupManagerVfr.Vfr
index 4d2c5378..9c940742 100644
--- a/Platform/CIX/Sky1/Drivers/SetupManagerDxe/SetupManagerVfr.Vfr
+++ b/Platform/CIX/Sky1/Drivers/SetupManagerDxe/SetupManagerVfr.Vfr
@@ -203,10 +203,12 @@ endif;
       text   = STRING_TOKEN(STR_STMM_VER_NAME),
       text   = STRING_TOKEN(STR_STMM_VER_VALUE);
 
+#ifndef BOARD_NO_EC
     text
       help   = STRING_TOKEN(STR_EMPTY_STRING),
       text   = STRING_TOKEN(STR_EC_VER_NAME),
       text   = STRING_TOKEN(STR_EC_VER_VALUE);
+#endif
   endform;
 
   form formid = SOC_FORM_SET_ID,
@@ -233,9 +235,11 @@ endif;
       prompt = STRING_TOKEN(STR_I2C_FORM_SET_TITLE),
       help   = STRING_TOKEN(STR_I2C_FORM_SET_TITLE_HELP);
 
+#ifndef BOARD_NO_GMAC
     goto GMAC_CONFIG_FORM_ID,
       prompt = STRING_TOKEN(STR_GMAC_FORM_SET_TITLE),
       help   = STRING_TOKEN(STR_GMAC_FORM_SET_TITLE_HELP);
+#endif
 
     oneof varid = PlatformSetupVar.SmmuEnable,
       prompt  = STRING_TOKEN(STR_ENABLE_SMMU_PROMPT),
