   SPDX-License-Identifier: BSD-2-Clause-Patent
 
 **/
+
+//
+// Boards may hide FCH I2C controllers from the OS regardless of the setup
+// option by setting bit n of ACPI_I2C_FORCE_DISABLE_MASK, and append pin
+// configuration to a controller's _CRS with ACPI_I2Cn_EXT_CRS.
+//
+#ifndef ACPI_I2C_FORCE_DISABLE_MASK
+#define ACPI_I2C_FORCE_DISABLE_MASK  0
+#endif
 #include <sky1-iomux.h>
 
 Device (I2C0) {
   Name (_HID, "CIXH200B")
   Name (_UID, 0x0)
   Method (_STA, 0x0, Serialized) {
+#if (ACPI_I2C_FORCE_DISABLE_MASK & (1 << 0))
+    Return (0x0)
+#else
     If(\_SB.GETV(ARV_FCH_I2C_0_ENABLE_OFFSET)){
         Return (0xF)
     } else {
         Return (0x0)
     }
+#endif
   }
   Method(_INI, 0) {
     Local0 = GETV(ARV_FCH_I2C_0_FREQ_OFFSET)
@@ -30,6 +43,9 @@ Device (I2C0) {
   Name (_CRS, ResourceTemplate () {
     Memory32Fixed (ReadWrite, I2C0_BASE, I2C0_SIZE)
     Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive) { FCH_INTR_I2C0_INTERRUPT_ID }
+#ifdef ACPI_I2C0_EXT_CRS
+    ACPI_I2C0_EXT_CRS
+#endif
     // Pinctrl
     PinGroupFunction(Exclusive, 0x0, "\\_SB.MUX0", 0, "pinctrl_fch_i2c0", ResourceConsumer,)
   })
