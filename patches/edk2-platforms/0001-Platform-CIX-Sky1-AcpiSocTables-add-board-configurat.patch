 .../Drivers/AcpiSocTables/Dsdt-Fch-Uart.asl   | 23 +++++++
 .../Sky1/Drivers/AcpiSocTables/Dsdt-Gmac.asl  |  6 +-
 .../Sky1/Drivers/AcpiSocTables/Dsdt-I2c.asl   | 65 +++++++++++++++++++
 .../Sky1/Drivers/AcpiSocTables/Dsdt-Pwm.asl   | 60 ++++++++++++++++-
 .../Sky1/Drivers/AcpiSocTables/Dsdt-SUSB.asl  | 12 ++++
 .../Sky1/Drivers/AcpiSocTables/Dsdt-Spi.asl   | 14 +++-
 .../Sky1/Drivers/AcpiSocTables/Dsdt-dst.asl   |  5 ++
 8 files changed, 204 insertions(+), 5 deletions(-)

