 #string STR_SECURE_RESET_TO_DEFAULTS_HELP  #language en-US "Enroll keys with data from default variables"
 #string STR_SECURE_RESET_TO_DEFAULTS       #language en-US "Reset Secure Boot Keys"
+
+#string STR_TPM_TITLE                      #language en-US "TPM"
+#string STR_TPM_HELP                       #language en-US "The TPM found by the firmware (TCG2 protocol)."
+#string STR_TPM_DEVICE_PROMPT              #language en-US "TPM Device"
+#string STR_TPM_DEVICE_CONTENT             #language en-US " "
+#string STR_TPM_VENDOR_PROMPT              #language en-US "TPM Vendor"
+#string STR_TPM_VENDOR_CONTENT             #language en-US " "
+#string STR_TPM_FIRMWARE_PROMPT            #language en-US "TPM Firmware"
+#string STR_TPM_FIRMWARE_CONTENT           #language en-US " "
+#string STR_TPM_PCR_BANKS_PROMPT           #language en-US "Active PCR Banks"
+#string STR_TPM_PCR_BANKS_CONTENT          #language en-US " "
 #string STR_RESET_TO_DEFAULTS_POPUP        #language en-US "Secure Boot Keys & databases will be initialized from defaults.\n Are you sure?"
 
 #string STR_SECURE_BOOT_ENROLL_SIGNATURE   #language en-US "Enroll Signature"
